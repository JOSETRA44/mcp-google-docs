{
  "name": "gdocs-native",
  "version": "0.1.0",
  "description": "MCP server that gives AI agents semantic, index-free control over Google Docs — read as markdown, edit by intent, collaborate safely under concurrent human edits",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gdocs-native": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-docs",
    "ai-agents",
    "markdown",
    "claude"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^13.1.0",
    "google-auth-library": "^10.9.1",
    "googleapis": "^173.0.0",
    "open": "^10.1.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "google-auth-library": "^10.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
